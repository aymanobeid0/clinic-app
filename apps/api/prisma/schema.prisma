generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Session {
  sid    String   @id @db.VarChar
  sess   Json
  expire DateTime @db.Timestamp(6)

  @@index([expire])
  @@map("session")
}

model Clinic {
  id                String    @id @default(uuid()) @db.Uuid
  code              String    @unique
  name              String
  accounts          Account[]
  nextPatientNumber Int       @default(0)
}

model Patient {
  id               String  @id @default(uuid()) @db.Uuid
  clinicId         String  @db.Uuid
  patientNumber    Int
  commandId        String  @db.Uuid
  registrationHash String
  name             String
  phone            String
  contactKind      String
  contactName      String
  archived         Boolean @default(false)
  revision         Int     @default(0)

  @@unique([clinicId, patientNumber])
  @@unique([clinicId, commandId])
  @@unique([clinicId, id])
}

model PatientHistory {
  id          String   @id @default(uuid()) @db.Uuid
  clinicId    String   @db.Uuid
  patientId   String   @db.Uuid
  actorId     String   @db.Uuid
  commandId   String   @db.Uuid
  payloadHash String
  action      String
  at          DateTime @db.Timestamptz(6)
  patient     Json

  @@unique([clinicId, commandId])
  @@index([clinicId, patientId])
}

model PatientAccessState {
  clinicId String @db.Uuid
  patientId String @db.Uuid
  revision Int @default(0)
  @@id([clinicId, patientId])
}

model PatientGrant {
  clinicId String @db.Uuid
  patientId String @db.Uuid
  accountId String @db.Uuid
  kind String
  active Boolean @default(true)
  @@id([clinicId, patientId, accountId])
}

model HistoricalRemoval {
 id String @id @db.Uuid
 clinicId String @db.Uuid
 patientId String @db.Uuid
 accountId String @db.Uuid
 cutoff DateTime @db.Timestamptz(6)
 snapshot Json
 @@unique([clinicId,patientId,accountId,id])
}
model HistoricalGrant {
 clinicId String @db.Uuid
 patientId String @db.Uuid
 accountId String @db.Uuid
 removalId String @db.Uuid
 @@id([clinicId,patientId,accountId])
}

model PatientAccessHistory {
  id String @id @default(uuid()) @db.Uuid
  clinicId String @db.Uuid
  patientId String @db.Uuid
  actorId String @db.Uuid
  accountId String @db.Uuid
  commandId String @db.Uuid
  payloadHash String
  action String
  at DateTime @db.Timestamptz(6)
  snapshot Json
  @@unique([clinicId, commandId])
  @@index([clinicId, patientId])
}

model Account {
  id                        String         @id @default(uuid()) @db.Uuid
  clinicId                  String         @db.Uuid
  clinic                    Clinic         @relation(fields: [clinicId], references: [id])
  username                  String
  kind                      String         @default("staff")
  permissions               String[]       @default([])
  contactEmail              String?
  phone                     String?
  historicalOnly            Boolean        @default(false)
  recoveryNotificationEmail String?
  recoverySetup             Boolean        @default(false)
  recoveryHash              String?
  recoveryExpiresAt         DateTime?      @db.Timestamptz(6)
  displayName               String
  loginMethod               String         @default("clinic_username")
  loginEmail                String?        @unique
  isManager                 Boolean        @default(false)
  passwordHash              String
  temporaryExpiresAt        DateTime?      @db.Timestamptz(6)
  revision                  Int            @default(0)
  credentialVersion         Int            @default(0)
  disabled                  Boolean        @default(false)
  recoveryEmail             String?
  verifiedEmail             String?
  verificationHash          String?
  verificationExpiresAt     DateTime?      @db.Timestamptz(6)
  codesBatchId              String?        @db.Uuid
  codesSaved                Boolean        @default(false)
  recoveryCodes             RecoveryCode[]

  @@unique([clinicId, username])
  @@unique([clinicId, verifiedEmail])
  @@unique([clinicId, id])
}

model RecoveryCode {
  id        String  @id @default(uuid()) @db.Uuid
  clinicId  String  @db.Uuid
  accountId String  @db.Uuid
  account   Account @relation(fields: [clinicId, accountId], references: [clinicId, id])
  hash      String

  @@index([clinicId, accountId])
}

model ReservedUsername {
  id        String @id @default(uuid()) @db.Uuid
  clinicId  String @db.Uuid
  accountId String @db.Uuid
  username  String

  @@unique([clinicId, username])
}

model SchedulingSettings {
  clinicId String @id @db.Uuid
  revision Int @default(0)
  defaultDurationMinutes Int @default(30)
  chairs String[] @default(["Fauteuil 1", "Fauteuil 2", "Fauteuil 3", "Fauteuil 4"])
}
model Appointment {
  id String @id @db.Uuid
  clinicId String @db.Uuid
  patientId String @db.Uuid
  dentistId String @db.Uuid
  chairId String?
  startsAt DateTime @db.Timestamptz(6)
  durationMinutes Int
  status String
  walkIn Boolean @default(false)
  revision Int @default(0)
  cancellationReason String @default("")
  @@unique([clinicId,id])
  @@index([clinicId,startsAt])
}
model SchedulingCommand {
  clinicId String @db.Uuid
  commandId String @db.Uuid
  actorId String @db.Uuid
  payloadHash String
  receipt Json
  @@id([clinicId,commandId])
}
model AppointmentHistory {
  id String @id @db.Uuid
  clinicId String @db.Uuid
  appointmentId String @db.Uuid
  actorId String @db.Uuid
  at DateTime @db.Timestamptz(6)
  action String
  override Boolean
  appointment Json
  @@index([clinicId,appointmentId])
}

model ClinicalRevision {
 id String @id @db.Uuid
 clinicId String @db.Uuid
 patientId String @db.Uuid
 kind String
 revision Int
 commandId String @db.Uuid
 actorId String @db.Uuid
 payloadHash String
 at DateTime @db.Timestamptz(6)
 snapshot Json
 receipt Json
 @@unique([clinicId,commandId])
 @@unique([clinicId,patientId,kind,revision])
 @@index([clinicId,patientId,at])
}

model ClinicCurrency {
 clinicId String @db.Uuid
 code String
 precision Int
 @@id([clinicId,code])
}
model CatalogProcedure {
 chartCategory String @default("manual")
 id String @id @db.Uuid
 clinicId String @db.Uuid
 revision Int
 name String
 currency String
 priceMinor BigInt
 durationMinutes Int
 active Boolean
 @@unique([clinicId,id])
}
model TreatmentCommand {
 clinicId String @db.Uuid
 commandId String @db.Uuid
 actorId String @db.Uuid
 payloadHash String
 receipt Json
 @@id([clinicId,commandId])
}

model TreatmentPlanRevision {
 id String @id @db.Uuid
 clinicId String @db.Uuid
 patientId String @db.Uuid
 planId String @db.Uuid
 revision Int
 authorId String @db.Uuid
 snapshot Json
 @@unique([clinicId,patientId,planId,revision])
}

model TreatmentPlanIdentity {
 clinicId String @db.Uuid
 planId String @db.Uuid
 patientId String @db.Uuid
 @@id([clinicId,planId])
 @@unique([clinicId,patientId,planId])
}

model TreatmentVisit {
 id String @id @db.Uuid
 clinicId String @db.Uuid
 patientId String @db.Uuid
 appointmentId String? @db.Uuid
 snapshot Json
 @@unique([clinicId,id])
 @@unique([clinicId,appointmentId])
}
model ProcedureStart {
 id String @id @db.Uuid
 clinicId String @db.Uuid
 patientId String @db.Uuid
 planId String @db.Uuid
 itemId String @db.Uuid
 visitId String @db.Uuid
 snapshot Json
 @@unique([clinicId,planId,itemId])
}

model ProcedureCompletion {
 id String @id @db.Uuid
 clinicId String @db.Uuid
 patientId String @db.Uuid
 planId String @db.Uuid
 itemId String @db.Uuid
 visitId String @db.Uuid
 snapshot Json
 @@unique([clinicId,planId,itemId])
}

model MedicationReference {
 id String @id @db.Uuid
 clinicId String @db.Uuid
 revision Int
 name String
 strength String
 form String
 active Boolean
 @@unique([clinicId,id])
}
model PrescriptionTemplate {
 clinicId String @id @db.Uuid
 revision Int
 header String
 footer String
}

model PrescriptionCommand {
 clinicId String @db.Uuid
 commandId String @db.Uuid
 actorId String @db.Uuid
 payloadHash String
 receipt Json
 @@id([clinicId,commandId])
}

model ChartSuggestionDecision {
 clinicId String @db.Uuid
 patientId String @db.Uuid
 completionId String @db.Uuid
 status String
 actorId String @db.Uuid
 at DateTime @db.Timestamptz(6)
 @@id([clinicId,completionId])
}

model BillingEntry {
 id String @id @db.Uuid
 clinicId String @db.Uuid
 patientId String @db.Uuid
 kind String
 sourceId String @db.Uuid
 performedBy String? @db.Uuid
 currency String
 amountMinor Decimal @db.Decimal(30,0)
 snapshot Json
 @@unique([clinicId,kind,sourceId])
 @@index([clinicId,patientId])
}

model BillingCommand {
 clinicId String @db.Uuid
 commandId String @db.Uuid
 actorId String @db.Uuid
 payloadHash String
 receipt Json
 @@id([clinicId,commandId])
}
model BillingMethod {
 clinicId String @db.Uuid
 id String @db.Uuid
 revision Int
 snapshot Json
 @@id([clinicId,id,revision])
}

model BillingInvoice {
 id String @id @db.Uuid
 clinicId String @db.Uuid
 patientId String @db.Uuid
 number String
 snapshot Json
 @@unique([clinicId,number])
 @@unique([clinicId,id])
 @@index([clinicId,patientId])
}
model BillingInvoiceCharge {
 clinicId String @db.Uuid
 chargeId String @db.Uuid
 invoiceId String @db.Uuid
 @@id([clinicId,chargeId])
}

model Attachment {
 id String @id @db.Uuid
 clinicId String @db.Uuid
 patientId String @db.Uuid
 classification String
 revision Int
 removed Boolean @default(false)
 events Json
 @@unique([clinicId,patientId,id])
 @@index([clinicId,patientId])
}
model AttachmentVersion {
 key String @id @db.Uuid
 clinicId String @db.Uuid
 patientId String @db.Uuid
 attachmentId String @db.Uuid
 revision Int
 size Int
 snapshot Json
 @@unique([clinicId,attachmentId,revision])
 @@index([clinicId,patientId])
}
model AttachmentReservation {
 key String @id @db.Uuid
 clinicId String @db.Uuid
 patientId String @db.Uuid
 commandId String @db.Uuid
 actorId String @db.Uuid
 payloadHash String
 size Int
 expiresAt DateTime @db.Timestamptz(6)
 cancelled Boolean @default(false)
 @@index([clinicId,commandId])
}
model AttachmentCommand {
 clinicId String @db.Uuid
 commandId String @db.Uuid
 actorId String @db.Uuid
 payloadHash String
 receipt Json
 @@id([clinicId,commandId])
}
