{
  "name": "clinic-app",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "npm run build --workspace @clinic/contracts && npm run build --workspace @clinic/api && npm run build --workspace @clinic/web",
    "dev": "tsx apps/api/src/server.ts",
    "test:db:up": "docker compose -p clinic-issue7-test -f infra/compose.test.yml up -d --wait",
    "test:db:down": "docker compose -p clinic-issue7-test -f infra/compose.test.yml down",
    "postinstall": "npm run build --workspace @clinic/contracts && npm run db:generate --workspace @clinic/api",
    "dev:web": "npm run dev --workspace @clinic/web",
    "provision": "tsx apps/api/src/provision.ts",
    "test:browser": "npm run test:browser --workspace @clinic/web",
    "test:db:prepare": "tsx apps/api/test/prepare.ts"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "tsx": "4.23.15",
    "vitest": "5.0.3",
    "supertest": "7.3.1",
    "@types/supertest": "7.2.1",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "typescript-eslint": "8.71.1",
    "prettier": "3.9.10",
    "prisma": "7.10.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.5"
  }
}
